{
  "name": "printer-share",
  "version": "1.0.0",
  "description": "Local network printer sharing server with drag-and-drop web upload",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/PrinterShare.exe"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pdf-to-printer": "^5.6.0",
    "virtual-printer": "^1.0.18"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
